<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
  xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

  <!--
    Single consolidated master changelog for AgencyService (Liquibase Re-Enablement Plan
    2026-07-04, package L1 "changelog truth").

    Replaces the five per-environment masters
    (local/dev/staging/testing/prod). Environments select changesets via Liquibase
    contexts (see spring.liquibase.contexts in each application-<profile>.properties),
    NOT via separate master files.

    Contexts (see spring.liquibase.contexts per profile):
      - contextFilter="seed": bootstrap changesets that create the base schema on an empty
        database. Only local/dev run these (spring.liquibase.contexts=seed). staging/prod use
        spring.liquibase.contexts=production, which does NOT match "seed", so the bootstrap is
        skipped there — their base schema is managed out-of-band (ORISO-Database repo).
      - no context: structural changesets that carry no context attribute and therefore run in
        EVERY context (seed and production alike). They are additive (nullable columns) so they
        are safe to apply on top of the existing staging/prod schema.

    NB: an EMPTY contexts filter means "run everything" in Liquibase, so staging/prod must pass
    a concrete non-"seed" context ("production"), not an empty string, to skip the bootstrap.

    IMPORTANT: changeset file paths are the Liquibase identity (id+author+filepath).
    Files are NOT moved or renamed. The seed changeset (0001) stays first in file order
    so that on a fresh local/dev database the base tables exist before the later ALTERs.

    Canonical structural order mirrors the former prod master (0002..0022).
  -->

  <!-- ==== Seed: fresh-database bootstrap (local/dev only) ==== -->
  <include file="db/changelog/changeset/0001_initsql/initSql.xml" contextFilter="seed"/>

  <!-- ==== Structural changesets (all environments) ==== -->
  <include file="db/changelog/changeset/0002_agency_id_old_null/0002_changeSet.xml"/>
  <include file="db/changelog/changeset/0003_agency_consulting_type/0003_changeSet.xml"/>
  <include file="db/changelog/changeset/0004_agency_offline/0004_changeSet.xml"/>
