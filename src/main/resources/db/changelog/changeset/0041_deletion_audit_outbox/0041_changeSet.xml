<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
  <!-- MariaDB DDL commits implicitly, so table and index are separate changesets: a run that
       stops between them re-runs only the missing step instead of hiding a half-applied one. -->
  <changeSet id="createDeletionAuditOutbox" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><tableExists tableName="deletion_audit_outbox"/></not>
    </preConditions>
    <createTable tableName="deletion_audit_outbox">
      <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
      </column>
      <column name="agency_id" type="BIGINT"><constraints nullable="false"/></column>
      <column name="tenant_id" type="BIGINT"/>
      <column name="outcome" type="VARCHAR(16)"><constraints nullable="false"/></column>
      <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
      <column name="delivered_at" type="DATETIME(6)"/>
    </createTable>
    <rollback><dropTable tableName="deletion_audit_outbox"/></rollback>
  </changeSet>
  <changeSet id="indexDeletionAuditOutboxPending" author="oriso">
    <preConditions onFail="MARK_RAN">
      <not><indexExists tableName="deletion_audit_outbox" indexName="idx_deletion_audit_outbox_pending"/></not>
    </preConditions>
    <createIndex tableName="deletion_audit_outbox" indexName="idx_deletion_audit_outbox_pending">
      <column name="delivered_at"/>
      <column name="id"/>
    </createIndex>
    <rollback><dropIndex tableName="deletion_audit_outbox" indexName="idx_deletion_audit_outbox_pending"/></rollback>
  </changeSet>
</databaseChangeLog>
